# POC local — voir docker-compose.yml pour les identifiants Postgres.
DATABASE_URL="postgresql://poc:poc@localhost:5433/nuits_garonne?schema=public"

# Cle de signature HMAC des QR codes des billets (POC uniquement — a garder secrete en production).
QR_SECRET="dev-secret-change-me"

# Quota anti-bot : nombre max de billets confirmes par email et par categorie.
MAX_TICKETS_PER_EMAIL=4
